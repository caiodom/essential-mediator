<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Package Metadata -->
    <PackageId>EssentialMediator.Abstractions</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <Title>EssentialMediator Abstractions</Title>
    <Description>Abstractions for EssentialMediator - a simple and efficient mediator pattern implementation for .NET</Description>
    <PackageTags>mediator;cqrs;abstractions;interfaces</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release of EssentialMediator abstractions with core interfaces and contracts.</PackageReleaseNotes>

    <!-- Package debugging and provenance -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
