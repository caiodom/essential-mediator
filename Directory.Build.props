<Project>
  <PropertyGroup>
    <!-- Shared build defaults -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Shared ownership and repository metadata -->
    <Authors>Caio Henrique Domingues Leite</Authors>
    <Copyright>Copyright © 2026 Caio Henrique Domingues Leite</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/caiodom/essential-mediator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/caiodom/essential-mediator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- NuGet security policy -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
